{
  "appName": "solix-renewable-energy",
  "version": "1.0.0",
  "environment": "production",
  "runtime": "nodejs-20",
  "buildCommand": "npm ci --prefix frontend && npm run build:frontend",
  "startCommand": "node frontend/.next/standalone/server.js",
  "port": 3000,
  "healthCheck": {
    "path": "/api/health",
    "intervalSeconds": 15,
    "timeoutSeconds": 5
  }
}
